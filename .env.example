# HireTrack settings. Copy to .env (start.bat / start.sh do this for you).
# Never commit .env.

# Secret used to sign login tokens. Leave empty and a random secret is
# generated on first run and kept in data/.jwt_secret. Set it only if you
# want tokens to survive deleting the data folder.
JWT_SECRET=

HOST=127.0.0.1
PORT=8000

# Keep the app offline after the one-time model download.
HF_HUB_OFFLINE=1

LOG_LEVEL=INFO
